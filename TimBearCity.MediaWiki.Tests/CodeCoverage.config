<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings, passed to the test application as "coverage-settings".
  See the "Coverage" section of README.md for the full command.

  Only the library is measured, and only the code in this repository: the JSON source generator emits several
  thousand lines into obj/, whose unused branches would otherwise dominate the result.
-->
<Configuration>
    <CodeCoverage>
        <ModulePaths>
            <Include>
                <ModulePath>.*TimBearCity\.MediaWiki\.dll$</ModulePath>
            </Include>
        </ModulePaths>

        <Sources>
            <Exclude>
                <Source>.*[\\/]obj[\\/].*</Source>
            </Exclude>
        </Sources>
    </CodeCoverage>
</Configuration>
