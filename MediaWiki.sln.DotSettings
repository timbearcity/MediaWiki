<wpf:ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:s="clr-namespace:System;assembly=mscorlib"
                        xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xml:space="preserve">
    <s:String x:Key="/Default/CodeStyle/CSharpFileLayoutPatterns/Pattern/@EntryValue">&lt;Patterns xmlns="urn:schemas-jetbrains-com:member-reordering-patterns"&gt;

  &lt;!-- Types whose field order is part of their binary layout must never be reordered. --&gt;
  &lt;TypePattern DisplayName="Explicitly laid out structs" Priority="200"&gt;
    &lt;TypePattern.Match&gt;
      &lt;HasAttribute Name="System.Runtime.InteropServices.StructLayoutAttribute" /&gt;
    &lt;/TypePattern.Match&gt;
  &lt;/TypePattern&gt;

  &lt;!-- StyleCop SA1201/SA1202/SA1203/SA1204/SA1214/SA1215 ordering, then alphabetical by name. --&gt;
  &lt;TypePattern DisplayName="Default" RemoveRegions="All"&gt;

    &lt;Entry DisplayName="Constant fields"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Constant" /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Name /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Fields"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Field" /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Static /&gt;
        &lt;Readonly /&gt;
        &lt;Name /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Constructors"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Constructor" /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Static /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Finalizers"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Destructor" /&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Delegates"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Delegate" /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Name /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Events"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Event" /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Static /&gt;
        &lt;Name /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Enums"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Enum" /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Name /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Properties"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Property" /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Static /&gt;
        &lt;Name /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Indexers"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Indexer" /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Interface implementations" Priority="100"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Member" /&gt;
          &lt;ImplementsInterface /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;ImplementsInterface Immediate="True" /&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Static /&gt;
        &lt;Name /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;!-- xUnit test methods keep their declared order: ReSharper's name sort is ordinal, which would put
         Foo_Bar_Baz after FooBar_Baz. Order these by hand. --&gt;
    &lt;Entry DisplayName="Test methods" Priority="100"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Method" /&gt;
          &lt;Or&gt;
            &lt;HasAttribute Name="Xunit.FactAttribute" Inherited="True" /&gt;
            &lt;HasAttribute Name="Xunit.TheoryAttribute" Inherited="True" /&gt;
          &lt;/Or&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Methods"&gt;
      &lt;Entry.Match&gt;
        &lt;Or&gt;
          &lt;Kind Is="Method" /&gt;
          &lt;Kind Is="Operator" /&gt;
        &lt;/Or&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Static /&gt;
        &lt;Name /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Structs"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Struct" /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Name /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Classes"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Class" /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Static /&gt;
        &lt;Name /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;!-- Nested interfaces, records and anything else not matched above. --&gt;
    &lt;Entry DisplayName="Other nested types"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Type" /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order="Public Internal ProtectedInternal Protected PrivateProtected Private" /&gt;
        &lt;Name /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

  &lt;/TypePattern&gt;

&lt;/Patterns&gt;</s:String>
    <s:String x:Key="/Default/dotCover/Filtering/ExcludedAssembliesString/@EntryValue">System.*||Microsoft.*||JetBrains.*||TimBearCity.MediaWiki.Tests</s:String>    <!-- Code Cleanup profile: "Full Cleanup" with "Arrange attributes" turned off, so [Theory] [InlineData] stacks, the JsonSerializable list and joined record attributes are left exactly as written. -->
    <s:Boolean x:Key="/Default/CodeStyle/CodeCleanup/Profiles/=MediaWiki/@KeyIndexDefined">True</s:Boolean>
    <s:String x:Key="/Default/CodeStyle/CodeCleanup/Profiles/=MediaWiki/@EntryIndexedValue">&lt;Profile name="MediaWiki"&gt;&lt;CSReorderTypeMembers&gt;True&lt;/CSReorderTypeMembers&gt;&lt;CSReformatCode&gt;True&lt;/CSReformatCode&gt;&lt;CSharpFormatDocComments&gt;True&lt;/CSharpFormatDocComments&gt;&lt;CSharpReformatComments&gt;True&lt;/CSharpReformatComments&gt;&lt;CSOptimizeUsings&gt;&lt;OptimizeUsings&gt;True&lt;/OptimizeUsings&gt;&lt;EmbraceInRegion&gt;False&lt;/EmbraceInRegion&gt;&lt;RegionName&gt;&lt;/RegionName&gt;&lt;/CSOptimizeUsings&gt;&lt;CSShortenReferences&gt;True&lt;/CSShortenReferences&gt;&lt;CSArrangeQualifiers&gt;True&lt;/CSArrangeQualifiers&gt;&lt;CSFixBuiltinTypeReferences&gt;True&lt;/CSFixBuiltinTypeReferences&gt;&lt;CSCodeStyleAttributes ArrangeVarStyle="True" ArrangeTypeAccessModifier="True" ArrangeTypeMemberAccessModifier="True" SortModifiers="True" ArrangeAccessors="True" ArrangeArgumentsStyle="True" RemoveRedundantParentheses="True" AddMissingParentheses="True" ArrangeBraces="True" ArrangeAttributes="False" ArrangeCodeBodyStyle="True" ArrangeTrailingCommas="True" ArrangeObjectCreation="True" ArrangeDefaultValue="True" ArrangeEmptyString="True" ArrangeNamespaces="True" ArrangeNullCheckingPattern="True" /&gt;&lt;RemoveCodeRedundancies&gt;True&lt;/RemoveCodeRedundancies&gt;&lt;CSUseAutoProperty&gt;True&lt;/CSUseAutoProperty&gt;&lt;CSMakeFieldReadonly&gt;True&lt;/CSMakeFieldReadonly&gt;&lt;CSMakeAutoPropertyGetOnly&gt;True&lt;/CSMakeAutoPropertyGetOnly&gt;&lt;CSUpdateFileHeader&gt;False&lt;/CSUpdateFileHeader&gt;&lt;/Profile&gt;</s:String>
    <s:String x:Key="/Default/CodeStyle/CodeCleanup/SilentCleanupProfile/@EntryValue">MediaWiki</s:String>
    <s:Boolean x:Key="/Default/Environment/SettingsMigration/IsMigratorApplied/=JetBrains_002EReSharper_002EPsi_002ECSharp_002ECodeStyle_002EMemberReordering_002EMigrations_002ECSharpFileLayoutPatternRemoveIsAttributeUpgrade/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=anonedits/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=articleexists/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=botedits/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=cirrussearch/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=docfx/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=editconflict/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=mediatype/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=movedpara/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=pagehistorycount/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=Parsoid/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=revertededits/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=thumbnailable/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=thumbnailed/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=Wikibase/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=wikidiff/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=wikitext/@EntryIndexedValue">True</s:Boolean>
</wpf:ResourceDictionary>
