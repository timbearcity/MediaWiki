<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <!--
          The library's target plus the newest runtime. The net11.0 build references the library's net10.0 build, which
          is the one a .NET 11 app gets.
        -->
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    </PropertyGroup>

    <!--
      Relaxations of the repository-wide rules in Directory.Build.props, which are aimed at the shipping library.
      Each one was needed to compile this project; none of them changes what the library itself is held to.
    -->
    <PropertyGroup Label="Test project exemptions">
        <!-- A test assembly is never trimmed or published as Native AOT. -->
        <IsAotCompatible>false</IsAotCompatible>
        <!-- The documentation file stays on: IDE0005 is only reported on build when it is generated. -->
        <!-- CS1591: nothing here ships, so there is no public API to document. -->
        <!-- CA1707: tests are named MethodUnderTest_Circumstances_ExpectedOutcome. -->
        <!-- CA1054: theory data passes URLs as strings, which is exactly what the option under test takes. -->
        <!--
          SYSLIB0066: .NET 11 obsoletes IStartupValidator, which the tests resolve as a .NET 10 host does. ValidateOnStart
          registers the same singleton as IAsyncStartupValidator, which a .NET 11 host runs, so either reaches the same check.
        -->
        <NoWarn>$(NoWarn);CS1591;CA1707;CA1054;SYSLIB0066</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
        <PackageReference Include="xunit.v3" Version="4.0.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../TimBearCity.MediaWiki/TimBearCity.MediaWiki.csproj" />
    </ItemGroup>

</Project>
