{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../TimBearCity.MediaWiki",
          "files": [
            "TimBearCity.MediaWiki.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "memberLayout": "separatePages",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "src": "..",
        "files": [
          "README.md",
          "CONTRIBUTING.md",
          "CHANGELOG.md"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "TimBearCity.MediaWiki",
      "_appTitle": "TimBearCity.MediaWiki",
      "_appFooter": "MIT. Not affiliated with or endorsed by the Wikimedia Foundation.",
      "_enableSearch": true,
      "_disableContribution": true,
      "pdf": false
    },
    "sitemap": {
      "baseUrl": "https://timbearcity.github.io/MediaWiki/"
    }
  }
}
