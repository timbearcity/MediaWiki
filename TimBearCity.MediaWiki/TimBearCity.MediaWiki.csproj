<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <Description>An unofficial .NET client for the MediaWiki REST API (/w/rest.php/v1/), covering every documented endpoint of the core API.</Description>
        <PackageTags>mediawiki;wikimedia;wikipedia;wiki;wikitext;rest;api;client</PackageTags>
    </PropertyGroup>

    <PropertyGroup Label="API contract">
        <EnablePackageValidation>true</EnablePackageValidation>
        <!--
          The latest version on NuGet, bumped once a release is published so that every pull request is checked against it. The bump also
          deletes CompatibilitySuppressions.xml, whose suppressions cover breaks the new baseline already ships.
        -->
        <PackageValidationBaselineVersion>0.3.1</PackageValidationBaselineVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="\" />
        <!-- The analyzer package already adds these as AdditionalFiles; the default None glob would list them a second time. -->
        <None Remove="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <!--
      The Microsoft.Extensions.* references stay on the major version of the target, so a consumer on .NET 10 is not
      forced onto a newer stack just to use this package. NuGet versions are floors; a net10.0 app on 10.x stays on 10.x.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    </ItemGroup>

    <!-- Build-time only; consumers do not take a dependency on it. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    </ItemGroup>

</Project>
