<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <!--
      Relaxations of the repository-wide rules in Directory.Build.props, which are aimed at the shipping library.
      Each one was needed to compile this project; none of them changes what the library itself is held to.
    -->
    <PropertyGroup Label="Test project exemptions">
        <!-- A test assembly is never trimmed or published as Native AOT. -->
        <IsAotCompatible>false</IsAotCompatible>
        <!-- The documentation file stays on: IDE0005 is only reported on build when it is generated. -->
        <!-- CS1591: nothing here ships, so there is no public API to document. -->
        <!-- CA1707: tests are named MethodUnderTest_Circumstances_ExpectedOutcome. -->
        <!-- CA1054: theory data passes URLs as strings, which is exactly what the option under test takes. -->
        <NoWarn>$(NoWarn);CS1591;CA1707;CA1054</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
        <PackageReference Include="xunit.v3" Version="4.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../TimBearCity.MediaWiki/TimBearCity.MediaWiki.csproj" />
    </ItemGroup>

</Project>
